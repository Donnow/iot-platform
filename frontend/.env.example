# Optional MQTT.js realtime channel for the operations console.
# The MQTT account must be allowed to subscribe to devices/+/+/status and event.
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_STATUS_TOPIC=devices/+/+/status
VITE_MQTT_EVENT_TOPIC=devices/+/+/event
