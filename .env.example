IOT_STORAGE_MODE=persistent
IOT_HTTP_ADDR=:8080
IOT_MQTT_BROKER_URL=tcp://emqx:1883
IOT_MQTT_CLIENT_ID=iot-platform
IOT_MQTT_USERNAME=iot-platform
IOT_MQTT_PASSWORD=replace-with-internal-mqtt-secret
IOT_DATABASE_URL=postgres://iot:iot@postgres:5432/iot?sslmode=disable
IOT_REDIS_ADDR=redis:6379
IOT_REDIS_PASSWORD=
IOT_REDIS_DB=0
IOT_TDENGINE_URL=http://tdengine:6041
IOT_TDENGINE_USERNAME=root
IOT_TDENGINE_PASSWORD=taosdata
# MQTT 消费流水线（worker 数 / 每分片队列容量）
IOT_MQTT_WORKERS=4
IOT_MQTT_QUEUE_SIZE=1024
# TDengine 批量写入（刷写行数 / 最大间隔毫秒）
IOT_TELEMETRY_BATCH_SIZE=200
IOT_TELEMETRY_BATCH_INTERVAL_MS=200
# 物模型查询缓存 TTL（秒）
IOT_PRODUCT_CACHE_TTL_SECONDS=60
IOT_JWT_SECRET=replace-with-at-least-16-random-characters
IOT_JWT_TTL_SECONDS=3600
# 首次启动自动创建的管理员账号（已在库中存在则跳过）；部署时必须修改密码
IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=admin123456
IOT_REQUEST_TIMEOUT_SECONDS=10
